{
  "name": "cashflow-app-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CashFlow Personal Finance App — Monorepo Workspace for Local & Vercel Deployment",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare-public": "node scripts/prepare-public.js",
    "build": "node scripts/prepare-public.js && npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.4.1",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "html-entities": "^2.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^3.2.0",
    "typescript": "^5.3.2"
  }
}
