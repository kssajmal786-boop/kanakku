# ─── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Server Database (Account Storage Only) ───────────────────
# PostgreSQL connection string for production.
# When empty or omitted, Kanakku automatically uses the built-in local relational store.
# STRICT PRIVACY: Stores only user identity (users table). NO financial data.
DATABASE_URL=postgresql://username:password@localhost:5432/kanakku_db

# ─── Google OAuth ─────────────────────────────────────────────
# Get these from https://console.cloud.google.com/
# Create OAuth 2.0 credentials → Web Application
# Add http://localhost:3001/auth/callback as Authorized Redirect URI
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback
# Reused for BOTH the login flow (POST /auth/google) and the separate
# "Connect Gmail" flow (POST /auth/gmail/connect) — /auth/callback
# branches internally on which one triggered it, so only ONE redirect
# URI needs to be registered in Google Cloud Console.
# No separate GOOGLE_TOKEN_ENCRYPTION_KEY is needed: connected Gmail
# refresh tokens are encrypted with the same AES-256-GCM utility
# (derived from JWT_SECRET) already used for the login flow's tokens.

# To enable real Google OAuth and Gmail read-only sync, create credentials at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# ─── Gemini AI ────────────────────────────────────────────────
# Get your free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=generate_another_long_random_string_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookie ───────────────────────────────────────────────────
COOKIE_SECRET=cashflow_cookie_secret_dev_16chars_min
COOKIE_SECURE=false

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
GMAIL_SYNC_RATE_LIMIT_WINDOW_MS=60000
GMAIL_SYNC_RATE_LIMIT_MAX=30


# ─── Gmail Sync ───────────────────────────────────────────────
GMAIL_MAX_EMAILS_PER_SYNC=500
GMAIL_INITIAL_LOOKBACK_DAYS=90

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
