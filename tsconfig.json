{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "*",
        "backend/node_modules/*"
      ]
    },
    "typeRoots": [
      "./backend/node_modules/@types"
    ]
  },
  "include": [
    "api/**/*",
    "backend/src/**/*"
  ]
}
